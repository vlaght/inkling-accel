+// local fusion #14 for Inkling 2: MUL(x, scale) + clip(x) (9 nodes -> 1 kernel, 96 calls/tok for Qcur and Rcur).
+template <int BLOCK>
+static __global__ void k_inkling_clip_mul(
+        const float * __restrict__ x, const float * __restrict__ w, float * __restrict__ dst,
+        const int64_t ncols, const int64_t ne1, const int64_t w_ne0, const int64_t w_ne1,
+        const float s, const float b, const float c, const float cmin, const float cmax) {
+    const int64_t row = blockIdx.x;
+    const float * xr  = x   + row * ncols;
+    float *       dr  = dst + row * ncols;
+    const int64_t w_row = (row % ne1) % w_ne1;
+    const float * wr  = w + w_row * w_ne0;
+    float sum = 0.0f;
+    float v0 = 0.0f;
+    if (ncols <= BLOCK) {
+        if (threadIdx.x < ncols) {
+            v0 = xr[threadIdx.x] * (w_ne0 == 1 ? wr[0] : wr[threadIdx.x]);
+            sum = v0 * v0;
+        }
+    } else {
+        for (int64_t k = threadIdx.x; k < ncols; k += BLOCK) {
+            const float v = xr[k] * (w_ne0 == 1 ? wr[0] : wr[k]);
+            sum += v * v;
+        }
+    }
+    sum = warp_reduce_sum(sum);
+    __shared__ float part[BLOCK/32];
+    if (threadIdx.x % 32 == 0) {
+        part[threadIdx.x/32] = sum;
+    }
+    __syncthreads();
+    float total = 0.0f;
+#pragma unroll
+    for (int ww = 0; ww < BLOCK/32; ++ww) {
+        total += part[ww];
+    }
+    const float n = sqrtf(total) * s + b;
+    const float f = fminf(fmaxf(c / n, cmin), cmax);
+    if (ncols <= BLOCK) {
+        if (threadIdx.x < ncols) {
+            dr[threadIdx.x] = v0 * f;
+        }
+    } else {
+        for (int64_t k = threadIdx.x; k < ncols; k += BLOCK) {
+            const float v = xr[k] * (w_ne0 == 1 ? wr[0] : wr[k]);
+            dr[k] = v * f;
+        }
+    }
+}
+
+static bool ggml_cuda_fuse_inkling_clip_mul(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 65536);
+    if (disabled || i + 9 > cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_MUL) {
+        return false;
+    }
+    static const enum ggml_op ops[9] = {
+        GGML_OP_MUL, GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE, GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL
+    };
+    const int out = i + 8;
+    if (!ggml_can_fuse_subgraph(cgraph, i, 9, ops, &out, 1)) {
+        return false;
+    }
+    ggml_tensor * const * n = cgraph->nodes + i;
+    const ggml_tensor * x = n[0]->src[0];
+    const ggml_tensor * w = n[0]->src[1];
+    if (n[1]->src[0] != n[0] || n[2]->src[0] != n[1] || n[3]->src[0] != n[2] || n[4]->src[0] != n[3] ||
+        n[5]->src[0] != n[4] || n[6]->src[0] != n[5] || n[6]->src[1] != n[4] || n[7]->src[0] != n[6] ||
+        n[8]->src[0] != n[0] || n[8]->src[1] != n[7]) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || n[8]->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(w) || !ggml_is_contiguous(n[8]) ||
+        !ggml_are_same_shape(x, n[8]) || n[2]->ne[0] != 1 || n[2]->ne[1] != x->ne[1] || n[2]->ne[2] != x->ne[2] || n[2]->ne[3] != x->ne[3] ||
+        (w->ne[0] != 1 && w->ne[0] != x->ne[0]) || (w->ne[1] != 1 && w->ne[1] != x->ne[1]) || w->ne[2] != 1 || w->ne[3] != 1 ||
+        !ggml_cuda_inkling_same_or_disjoint(n[8], x) || !ggml_cuda_inkling_same_or_disjoint(n[8], w)) {
+        return false;
+    }
+    float s, b, c, cmin, cmax;
+    memcpy(&s,    (const float *) n[4]->op_params + 0, sizeof(float));
+    memcpy(&b,    (const float *) n[4]->op_params + 1, sizeof(float));
+    memcpy(&c,    (const float *) n[5]->op_params + 0, sizeof(float));
+    memcpy(&cmin, (const float *) n[7]->op_params + 0, sizeof(float));
