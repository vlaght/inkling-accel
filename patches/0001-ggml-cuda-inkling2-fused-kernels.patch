 // try and fuse nodes and return the number of nodes to skip
+// An elementwise kernel (each thread reads index k of its inputs and writes index k of the output, after any row reduction
+// is done) is safe when the output is disjoint from an input or lies exactly on it (the allocator reuses a dead input in place).
+static bool ggml_cuda_inkling_same_or_disjoint(const ggml_tensor * dst, const ggml_tensor * src) {
+    const char * d0 = (const char *) dst->data, * d1 = d0 + ggml_nbytes(dst);
+    const char * s0 = (const char *) src->data, * s1 = s0 + ggml_nbytes(src);
+    if (d1 <= s0 || s1 <= d0) {
+        return true;
+    }
+    return d0 == s0 && ggml_nbytes(dst) == ggml_nbytes(src);
+}
+
+static int ggml_cuda_inkling_nofuse_mask() {
+    static const int mask = [] { const char * e = getenv("OOT2_NOFUSE_MASK"); return e ? atoi(e) : 0; }();
+    return mask;
+}
+
+// ---- local fusion for Inkling 2 (see ~/dev/inkling-tuning.md): clip(x) = x * clamp(c / (sqrt(sum(x^2)) * s + b), 0, 1) is
+// SQR, SUM_ROWS, SQRT, SCALE, FILL, DIV, CLAMP, MUL: eight kernels per call and 144 calls per token. One block per row.
+template <int BLOCK>
+static __global__ void k_inkling_clip(const float * x, float * dst, const int64_t ncols, const float s, const float b,
+                                      const float c, const float cmin, const float cmax) {
+    const float * xr = x   + (int64_t) blockIdx.x * ncols;
+    float *       dr = dst + (int64_t) blockIdx.x * ncols;
+    float sum = 0.0f;
+    for (int64_t k = threadIdx.x; k < ncols; k += BLOCK) {
+        sum += xr[k] * xr[k];
+    }
+    sum = warp_reduce_sum(sum);
+    __shared__ float part[BLOCK/32];
+    if (threadIdx.x % 32 == 0) {
+        part[threadIdx.x/32] = sum;
+    }
+    __syncthreads();
+    float total = 0.0f;
+#pragma unroll
+    for (int w = 0; w < BLOCK/32; ++w) {
+        total += part[w];
+    }
+    const float n = sqrtf(total) * s + b;
+    const float f = fminf(fmaxf(c / n, cmin), cmax);
+    for (int64_t k = threadIdx.x; k < ncols; k += BLOCK) {
+        dr[k] = xr[k] * f;
+    }
+}
+
+static bool ggml_cuda_fuse_inkling_clip(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 1);
+    if (disabled || i + 8 > cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_SQR) {
+        return false;
+    }
+    static const enum ggml_op ops[8] = { GGML_OP_SQR, GGML_OP_SUM_ROWS, GGML_OP_SQRT, GGML_OP_SCALE, GGML_OP_FILL, GGML_OP_DIV, GGML_OP_CLAMP, GGML_OP_MUL };
+    const int out = i + 7;
+    if (!ggml_can_fuse_subgraph(cgraph, i, 8, ops, &out, 1)) {
+        return false;
+    }
+    ggml_tensor * const * n = cgraph->nodes + i;
+    const ggml_tensor * x = n[0]->src[0];
+    if (!ggml_cuda_inkling_same_or_disjoint(n[7], x)) {
+        return false;
+    }
+    // the chain's dataflow must be exactly the clip() one: x -> sqr -> sum -> sqrt -> scale -> (fill, div) -> clamp -> mul(x, .)
+    if (n[1]->src[0] != n[0] || n[2]->src[0] != n[1] || n[3]->src[0] != n[2] || n[4]->src[0] != n[3] ||
+        n[5]->src[0] != n[4] || n[5]->src[1] != n[3] || n[6]->src[0] != n[5] || n[7]->src[0] != x || n[7]->src[1] != n[6]) {
+        return false;
+    }
+    if (x->type != GGML_TYPE_F32 || n[7]->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || !ggml_is_contiguous(n[7]) ||
+        !ggml_are_same_shape(x, n[7]) || n[1]->ne[0] != 1 || n[1]->ne[1] != x->ne[1] || n[1]->ne[2] != x->ne[2] || n[1]->ne[3] != x->ne[3]) {
+        return false;
+    }
+    float s, b, c, cmin, cmax;
+    memcpy(&s,    (const float *) n[3]->op_params + 0, sizeof(float));
+    memcpy(&b,    (const float *) n[3]->op_params + 1, sizeof(float));
+    memcpy(&c,    (const float *) n[4]->op_params + 0, sizeof(float));
+    memcpy(&cmin, (const float *) n[6]->op_params + 0, sizeof(float));
+    memcpy(&cmax, (const float *) n[6]->op_params + 1, sizeof(float));
+    const int64_t nrows = ggml_nrows(x);
+    k_inkling_clip<128><<<(unsigned) nrows, 128, 0, cuda_ctx->stream()>>>((const float *) x->data, (float *) n[7]->data, x->ne[0], s, b, c, cmin, cmax);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
