+// local fusion #15 for Inkling 2 (bit 524288): fuses CONCAT + SSM_CONV + RESHAPE + ADD + SCALE + VIEW + (VIEW) + CPY
+// into a single kernel, eliminating the intermediate concatenated window write/read and 176 concat_cpy launches/tok.
+static __global__ void k_inkling_concat_conv_add_scale(
+        const char * __restrict__ a, const char * __restrict__ b,
+        const float * __restrict__ w, const float * __restrict__ cur,
+        const float * __restrict__ res_add,
+        float * __restrict__ dst, float * __restrict__ cell,
+        const int64_t C, const int64_t nt, const int64_t ns, const int64_t ne0a,
+        const size_t a_nb0, const size_t a_nb1, const size_t a_nb2,
+        const size_t b_nb0, const size_t b_nb1, const size_t b_nb2,
+        const size_t w_nb1, const int dc, const int64_t n_cols, const size_t cell_nb1,
+        const float scale, const float bias) {
+    const int64_t k = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (k >= C * nt * ns) {
+        return;
+    }
+    const int64_t ch = k % C;
+    const int64_t t  = (k / C) % nt;
+    const int64_t sq = k / (C * nt);
+    const float * wr = (const float *) ((const char *) w + ch * w_nb1);
+    const bool write_cell = (t == nt - 1);
+    const int64_t cell_base = n_cols * ch + sq * (int64_t) (cell_nb1 / sizeof(float));
+    const int j_first = dc - (int) n_cols;
+
+    float sumf = 0.0f;
+    for (int j = 0; j < dc; ++j) {
+        const int64_t pos = t + j;
+        const float xv = pos < ne0a
+            ? *(const float *) (a + pos * a_nb0 + ch * a_nb1 + sq * a_nb2)
+            : *(const float *) (b + (pos - ne0a) * b_nb0 + ch * b_nb1 + sq * b_nb2);
+        sumf += xv * wr[j];
+        if (write_cell && j >= j_first) {
+            cell[cell_base + (j - j_first)] = xv;
+        }
+    }
+    const float v = __fadd_rn(cur[k], sumf);
+    float out = __fadd_rn(__fmul_rn(v, scale), bias);
+    if (res_add) {
+        out = __fadd_rn(res_add[k], out);
+    }
+    dst[k] = out;
+}
