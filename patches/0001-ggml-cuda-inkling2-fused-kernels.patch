+// local fusion #13 for Inkling 2: full-attention dynamic convolve(): SSM_CONV + 4x(VIEW, TRANSPOSE, CONT, RESHAPE, VIEW, MUL, RESHAPE, ADD) + ADD(cur) + SCALE
+// (37 nodes, 15 kernels) -> one kernel (bitwise identical to unfused).
+static __global__ void k_inkling_conv_dyn_add_scale(
+        const float * __restrict__ sx, const float * __restrict__ w, const float * __restrict__ dyn, const float * __restrict__ cur, float * __restrict__ dst,
+        const int64_t C, const int64_t nt, const int64_t ns, const int64_t sx_ne0, const size_t w_nb1,
+        const int dc, const int n_heads, const float scale, const float bias) {
+    const int64_t k = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (k >= C * nt * ns) {
+        return;
+    }
+    const int64_t ch    = k % C;
+    const int64_t t_seq = (k / C) % nt;
+    const int64_t sq    = k / (C * nt);
+    const int64_t t     = sq * nt + t_seq;
+    const int64_t hd    = C / n_heads;
+    const int64_t head  = ch / hd;
+    const float * x     = sx + sq * C * sx_ne0 + ch * sx_ne0 + t_seq;
+    const float * wr    = (const float *) ((const char *) w + ch * w_nb1);
+    const float * dy    = dyn + (t * n_heads + head) * dc;
+    float sumf = 0.0f;
+    for (int j = 0; j < dc; ++j) {
+        sumf += x[j] * wr[j];
+    }
+    for (int lag = 0; lag < dc; ++lag) {
+        sumf = __fadd_rn(sumf, __fmul_rn(x[dc - 1 - lag], dy[lag]));
+    }
+    const float v = __fadd_rn(cur[k], sumf);
+    dst[k] = __fadd_rn(__fmul_rn(v, scale), bias);
+}
+
+static bool ggml_cuda_fuse_inkling_conv_dyn_add_scale(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 4096);
+    if (disabled || i + 37 > cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_SSM_CONV) {
+        return false;
+    }
+    ggml_tensor * const * n = cgraph->nodes + i;
+    if (n[1]->op != GGML_OP_RESHAPE || n[2]->op != GGML_OP_VIEW || n[3]->op != GGML_OP_TRANSPOSE ||
+        n[6]->op != GGML_OP_RESHAPE || n[7]->op != GGML_OP_VIEW ||
+        n[35]->op != GGML_OP_ADD || n[36]->op != GGML_OP_SCALE) {
+        return false;
+    }
+    static const enum ggml_op ops[24] = {
+        GGML_OP_SSM_CONV, GGML_OP_RESHAPE,
+        GGML_OP_CONT, GGML_OP_RESHAPE, GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_ADD,
+        GGML_OP_CONT, GGML_OP_RESHAPE, GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_ADD,
+        GGML_OP_CONT, GGML_OP_RESHAPE, GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_ADD,
+        GGML_OP_CONT, GGML_OP_RESHAPE, GGML_OP_MUL, GGML_OP_RESHAPE, GGML_OP_ADD,
+        GGML_OP_ADD, GGML_OP_SCALE
+    };
+    const int idxs[24] = {
+        i, i + 1,
+        i + 4, i + 5, i + 8, i + 9, i + 10,
+        i + 13, i + 14, i + 16, i + 17, i + 18,
+        i + 21, i + 22, i + 24, i + 25, i + 26,
+        i + 29, i + 30, i + 32, i + 33, i + 34,
+        i + 35, i + 36
+    };
+    const int out = i + 36;
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, 24, ops, &out, 1)) {
+        return false;
+    }
+    const ggml_tensor * sx  = n[0]->src[0];
+    const ggml_tensor * w   = n[0]->src[1];
+    const ggml_tensor * dyn = n[6]->src[0];
+    const ggml_tensor * cur = n[35]->src[0] == n[34] ? n[35]->src[1] : n[35]->src[0];
+    const ggml_tensor * dst = n[36];
+    const int64_t C  = n[0]->ne[0];
+    const int64_t nt = n[0]->ne[1];
+    const int64_t ns = n[0]->ne[2];
+    const int     dc = (int) w->ne[0];
+    if (dc != 4 || n[1]->src[0] != n[0] || n[36]->src[0] != n[35] || (n[35]->src[0] != n[34] && n[35]->src[1] != n[34])) {
+        return false;
+    }
+    const int n_heads = (int) (dyn->ne[0] / dc);
+    if (n_heads < 1 || C % n_heads != 0 || dyn->ne[0] != (int64_t) dc * n_heads ||
+        sx->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || dyn->type != GGML_TYPE_F32 || cur->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(sx) || sx->ne[1] != C || sx->ne[2] != ns || sx->ne[0] != nt + dc - 1 ||
+        w->nb[0] != sizeof(float) || w->ne[1] != C ||
+        !ggml_is_contiguous(dyn) || dyn->ne[1] != nt * ns || dyn->ne[2] != 1 || dyn->ne[3] != 1 ||
+        !ggml_is_contiguous(cur) || ggml_nelements(cur) != C * nt * ns ||
+        !ggml_is_contiguous(dst) || ggml_nelements(dst) != C * nt * ns ||
+        !ggml_cuda_inkling_same_or_disjoint(dst, sx) || !ggml_cuda_inkling_same_or_disjoint(dst, w) ||
+        !ggml_cuda_inkling_same_or_disjoint(dst, dyn) || !ggml_cuda_inkling_same_or_disjoint(dst, cur)) {
+        return false;
+    }
+    // verify all 4 lag blocks wiring and offsets
+    const ggml_tensor * prev_add = n[1];
+    for (int lag = 0; lag < 4; ++lag) {
+        const int b = lag == 0 ? 2 : (11 + (lag - 1) * 8);
+        const int tap_idx = lag == 0 ? 7 : (b + 4);
+        const int mul_idx = lag == 0 ? 8 : (b + 5);
+        const int rsh_idx = lag == 0 ? 9 : (b + 6);
+        const int add_idx = lag == 0 ? 10 : (b + 7);
+        if (n[b]->op != GGML_OP_VIEW || n[b]->view_src != sx ||
+            (const char *) n[b]->data != (const char *) sx->data + (size_t) (dc - 1 - lag) * sx->nb[0] ||
+            n[b + 1]->op != GGML_OP_TRANSPOSE || n[b + 1]->src[0] != n[b] ||
+            n[b + 2]->src[0] != n[b + 1] || n[b + 3]->src[0] != n[b + 2] ||
+            n[tap_idx]->op != GGML_OP_VIEW || n[tap_idx]->view_src != dyn ||
+            (const char *) n[tap_idx]->data != (const char *) dyn->data + (size_t) lag * sizeof(float) ||
+            n[mul_idx]->src[0] != n[b + 3] || n[mul_idx]->src[1] != n[tap_idx] ||
+            n[rsh_idx]->src[0] != n[mul_idx] || n[add_idx]->src[0] != prev_add || n[add_idx]->src[1] != n[rsh_idx]) {
+            return false;
+        }
+        prev_add = n[add_idx];
+    }
+    float scale, bias;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&bias,  (const float *) dst->op_params + 1, sizeof(float));
+    const int64_t total = C * nt * ns;
+    k_inkling_conv_dyn_add_scale<<<(unsigned) ((total + 127)/128), 128, 0, cuda_ctx->stream()>>>(
+        (const float *) sx->data, (const float *) w->data, (const float *) dyn->data, (const float *) cur->data, (float *) dst->data,
+        C, nt, ns, sx->ne[0], w->nb[1], dc, n_heads, scale, bias);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
