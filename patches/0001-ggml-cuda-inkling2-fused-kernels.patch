-#include <vector>
 
 #if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
 #include "ggml-backend-dl.h"
@@ -4466,6 +4465,660 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
