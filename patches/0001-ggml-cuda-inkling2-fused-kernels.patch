+static bool ggml_cuda_fuse_inkling_control_tail(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 1024);
+    if (disabled || i + 8 > cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_MUL_MAT || cgraph->nodes[i + 1]->op != GGML_OP_UNARY || cgraph->nodes[i + 4]->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    static const enum ggml_op ops[8] = { GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_SUB, GGML_OP_MUL_MAT, GGML_OP_UNARY, GGML_OP_MUL, GGML_OP_ADD };
+    const int out = i + 7;
+    ggml_tensor * const * n = cgraph->nodes + i;
+    if (ggml_get_unary_op(n[1]) != GGML_UNARY_OP_TANH || n[5]->op != GGML_OP_UNARY || ggml_get_unary_op(n[5]) != GGML_UNARY_OP_TANH || !ggml_can_fuse_subgraph(cgraph, i, 8, ops, &out, 1)) {
+        return false;
+    }
+    const ggml_tensor * Wf = n[0]->src[0], * g = n[0]->src[1], * cur = n[2]->src[1], * Wg = n[4]->src[0], * msg = n[6]->src[1];
+    if (n[1]->src[0] != n[0] || n[2]->src[0] != n[1] || n[3]->src[0] != cur || n[3]->src[1] != n[2] || n[4]->src[1] != g || n[5]->src[0] != n[4] ||
+        n[6]->src[0] != n[5] || n[7]->src[0] != n[3] || n[7]->src[1] != n[6]) {
+        return false;
+    }
+    const int n_embd = (int) n[0]->ne[0], T = (int) n[0]->ne[1], R = (int) Wf->ne[0];
