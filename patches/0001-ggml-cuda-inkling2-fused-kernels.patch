+static bool ggml_cuda_fuse_inkling_mix_attn(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 512);
+    if (disabled || cgraph->nodes[i]->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cgraph->nodes[i], 0) != 1) {
+        return false;
+    }
+    int m = 0;
+    while (i + m < cgraph->n_nodes && m < 15 && cgraph->nodes[i + m]->op == GGML_OP_CONCAT && ggml_get_op_params_i32(cgraph->nodes[i + m], 0) == 1 &&
+           (m == 0 || cgraph->nodes[i + m]->src[1] == cgraph->nodes[i + m - 1])) {
+        ++m;
+    }
+    if (m < 1 || i + m + 7 > cgraph->n_nodes) {
+        return false;
+    }
+    enum ggml_op ops[24];
+    for (int j = 0; j < m; ++j) ops[j] = GGML_OP_CONCAT;
+    // one token: the queries are a reshape of the weight; more tokens: a repeat of it per token
+    const bool repeated = i + m + 3 < cgraph->n_nodes && cgraph->nodes[i + m + 3]->op == GGML_OP_REPEAT;
+    ops[m] = GGML_OP_RMS_NORM; ops[m + 1] = GGML_OP_TRANSPOSE; ops[m + 2] = GGML_OP_CONT; ops[m + 3] = repeated ? GGML_OP_REPEAT : GGML_OP_RESHAPE;
+    ops[m + 4] = GGML_OP_MUL_MAT; ops[m + 5] = GGML_OP_SOFT_MAX; ops[m + 6] = GGML_OP_MUL_MAT;
+    const int count = m + 7, out = i + m + 6;
+    ggml_tensor * const * n = cgraph->nodes + i;
+    for (int j = 0; j < count; ++j) {
+        if (n[j]->op != ops[j]) {
+            return false;
+        }
+    }
+    if (n[m]->src[0] != n[m - 1] || n[m + 1]->src[0] != n[m] || n[m + 2]->src[0] != n[m + 1] || n[m + 4]->src[0] != n[m] || n[m + 4]->src[1] != n[m + 3] ||
+        n[m + 5]->src[0] != n[m + 4] || n[m + 5]->src[1] != nullptr || n[m + 5]->src[2] != nullptr || n[m + 6]->src[0] != n[m + 2] || n[m + 6]->src[1] != n[m + 5] ||
+        !ggml_can_fuse_subgraph(cgraph, i, count, ops, &out, 1)) {
+        return false;
+    }
+    const ggml_tensor * xnn = n[m], * qv = n[m + 3]->src[0], * dst = n[m + 6];
+    const int ncols = (int) xnn->ne[0], B = (int) xnn->ne[1], T = (int) xnn->ne[2], NQ = (int) qv->ne[1];
+    float eps, sm_scale, max_bias;
+    memcpy(&eps,      (const float *) xnn->op_params + 0, sizeof(float));
+    memcpy(&sm_scale, (const float *) n[m + 5]->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (const float *) n[m + 5]->op_params + 1, sizeof(float));
+    if (B != m + 1 || T < 1 || T > 65535 || max_bias != 0.0f || NQ < 1 || NQ > 4 || B > 16 || xnn->type != GGML_TYPE_F32 || !ggml_is_contiguous(xnn) || ncols % 4 != 0 || ncols/4 > 1024 ||
+        ((uintptr_t) xnn->data) % 16 != 0 || qv->type != GGML_TYPE_F32 || !ggml_is_contiguous(qv) || qv->ne[0] != ncols || qv->ne[2] != 1 || qv->ne[3] != 1 || n[m + 3]->ne[0] != ncols || n[m + 3]->ne[1] != NQ || n[m + 3]->ne[2] != T || ((uintptr_t) qv->data) % 16 != 0 ||
+        dst->type != GGML_TYPE_F32 || !ggml_is_contiguous(dst) || dst->ne[0] != ncols || dst->ne[1] != NQ || dst->ne[2] != T ||
+        n[m + 4]->type != GGML_TYPE_F32 || ggml_nelements(n[m + 4]) != (int64_t) B*NQ*T) {
+        return false;
+    }
+    ggml_inkling_rows rows;
+    size_t nb2 = 0;
+    bool two_kern_ok = ggml_inkling_disjoint(dst, xnn) && ggml_inkling_disjoint(dst, n[m + 4]) &&
+                       ggml_inkling_disjoint(n[m + 4], qv) && ggml_inkling_disjoint(xnn, qv) &&
+                       ggml_inkling_disjoint(n[m + 4], xnn);
+    for (int r = 0; r <= m; ++r) {
+        const ggml_tensor * v = r == m ? n[0]->src[1] : n[m - r - 1]->src[0];
+        if (v->type != GGML_TYPE_F32 || v->ne[0] != ncols || v->ne[1] != 1 || v->ne[2] != T || v->ne[3] != 1 || v->nb[0] != sizeof(float) ||
+            ((uintptr_t) v->data) % 16 != 0 || (v->nb[2] % 16) != 0 || (r > 0 && v->nb[2] != nb2)) {
+            return false;
+        }
+        if (!ggml_inkling_disjoint(xnn, v) || !ggml_inkling_disjoint(n[m + 4], v)) {
+            two_kern_ok = false;
+        }
+        nb2 = v->nb[2];
+        rows.p[r] = (const char *) v->data;
+    }
+    static const bool no_single = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 131072);
+    if (!no_single) {
+        bool dst_ok = ggml_inkling_disjoint(dst, qv);
+        for (int r = 0; dst_ok && r <= m; ++r) {
+            const ggml_tensor * v = r == m ? n[0]->src[1] : n[m - r - 1]->src[0];
+            if (!(NQ == 1 ? ggml_cuda_inkling_same_or_disjoint(dst, v) : ggml_inkling_disjoint(dst, v))) {
+                dst_ok = false;
+            }
+        }
+        if (dst_ok && ((uintptr_t) dst->data) % 16 == 0) {
+            static const bool no_regq = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 262144);
+            if (!no_regq && ncols <= 3072 && ncols >= 1024) {
+                switch (NQ) {
+                    case 1: k_inkling_mix_regq<1><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                    case 2: k_inkling_mix_regq<2><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                    case 3: k_inkling_mix_regq<3><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                    case 4: k_inkling_mix_regq<4><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                }
+            } else {
+                switch (NQ) {
+                    case 1: k_inkling_mix_single<1><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                    case 2: k_inkling_mix_single<2><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                    case 3: k_inkling_mix_single<3><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                    case 4: k_inkling_mix_single<4><<<T, 256, 0, cuda_ctx->stream()>>>(rows, nb2, (const float *) qv->data, (float *) dst->data, B, ncols, eps, sm_scale); break;
+                }
+            }
+            CUDA_CHECK(cudaGetLastError());
+            return true;
+        }
+    }
+    if (!two_kern_ok) {
+        return false;
+    }
+    k_inkling_mix_dots<<<dim3(B, T, 1), 1024, 0, cuda_ctx->stream()>>>(rows, nb2, (float *) xnn->data, (const float *) qv->data, (float *) n[m + 4]->data, B, ncols, NQ, eps, sm_scale);
+    CUDA_CHECK(cudaGetLastError());
+    k_inkling_mix_out<<<dim3((ncols + 255)/256, T, 1), 256, 0, cuda_ctx->stream()>>>((const float *) xnn->data, (const float *) n[m + 4]->data, (float *) dst->data, B, ncols, NQ);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
