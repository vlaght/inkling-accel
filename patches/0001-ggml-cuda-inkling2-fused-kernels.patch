+// local fusion #12 for Inkling 2: relative-position bias + sink subtraction + gather + transpose + F16 attention mask:
+// PAD, MUL_MAT, RESHAPE(sinks), SUB, PERMUTE, CONT, GET_ROWS, RESHAPE, PERMUTE, CONT, CPY(f16->f32), ADD, CPY(f32->f16)
+// (13 nodes, 9 kernels) -> one kernel computing dot(rel_bias[rel_pos], Rcur) - sink + mask directly into F16.
+template <int NREL>
+static __global__ void k_inkling_rel_bias_mask(
+        const float * __restrict__ rel_bias, const float * __restrict__ Rcur, const float * __restrict__ sinks,
+        const int32_t * __restrict__ rel_pos, const half * __restrict__ mask_f16, half * __restrict__ dst,
+        const int n_ext, const int n_head, const int n_kv, const int TS) {
+    __shared__ float s_R[64][NREL];
+    __shared__ float s_sink[64];
+    __shared__ float s_bias[32][NREL + 1];
+    __shared__ float s_mask[32];
+    __shared__ int32_t s_idx[32];
+
+    const int kv_base = blockIdx.x * 32;
+    const int t       = blockIdx.y;
+    const int lane    = threadIdx.x; // 0..31
+    const int warp    = threadIdx.y; // 0..7
+    const int tid     = warp * 32 + lane;
+
+    const float * Rt = Rcur + (int64_t) t * n_head * NREL;
+    for (int idx = tid; idx < n_head * NREL; idx += 256) {
+        s_R[idx / NREL][idx % NREL] = Rt[idx];
+    }
+    if (tid < n_head) {
+        s_sink[tid] = sinks[(int64_t) t * n_head + tid];
+    }
+    if (warp == 0) {
+        const int kv = kv_base + lane;
+        if (kv < n_kv) {
+            s_idx[lane]  = rel_pos[(int64_t) t * n_kv + kv];
+            s_mask[lane] = __half2float(mask_f16[(int64_t) t * n_kv + kv]);
+        } else {
+            s_idx[lane]  = n_ext;
+            s_mask[lane] = 0.0f;
+        }
+    }
+    __syncthreads();
+
+    for (int idx = tid; idx < 32 * NREL; idx += 256) {
+        const int k   = idx / NREL;
+        const int r   = idx % NREL;
+        const int row = s_idx[k];
+        s_bias[k][r]  = (row >= 0 && row < n_ext) ? rel_bias[(int64_t) row * NREL + r] : 0.0f;
+    }
+    __syncthreads();
+
+    const int kv = kv_base + lane;
+    if (kv < n_kv) {
+        const int s  = t / TS;
+        const int ts = t % TS;
+        const int64_t head_stride = (int64_t) n_kv * TS;
+        const int64_t base = (int64_t) s * head_stride * n_head + (int64_t) ts * n_kv + kv;
+        const float m = s_mask[lane];
+        for (int h = warp; h < n_head; h += 8) {
+            float dot = 0.0f;
+#pragma unroll
+            for (int r = 0; r < NREL; ++r) {
+                dot += s_bias[lane][r] * s_R[h][r];
+            }
+            dst[base + (int64_t) h * head_stride] = __float2half(dot - s_sink[h] + m);
+        }
+    }
+}
+
+static bool ggml_cuda_fuse_inkling_rel_bias_mask(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph, int i) {
+    static const bool disabled = getenv("OOT2_NOFUSE") != nullptr || (ggml_cuda_inkling_nofuse_mask() & 2048);
+    if (disabled || i + 13 > cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_PAD) {
+        return false;
+    }
+    const ggml_tensor * cpy_mask = cgraph->nodes[i + 10];
+    const int expected_uses = cpy_mask->src[1] == cpy_mask ? 2 : 1;
+    if (cgraph->nodes[i + 2]->op != GGML_OP_RESHAPE || cpy_mask->op != GGML_OP_CPY ||
+        ggml_node_get_use_count(cgraph, i + 10) != expected_uses || (cpy_mask->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+    static const enum ggml_op ops[11] = {
+        GGML_OP_PAD, GGML_OP_MUL_MAT, GGML_OP_SUB, GGML_OP_PERMUTE, GGML_OP_CONT,
+        GGML_OP_GET_ROWS, GGML_OP_RESHAPE, GGML_OP_PERMUTE, GGML_OP_CONT, GGML_OP_ADD, GGML_OP_CPY
+    };
+    const int idxs[11] = { i, i + 1, i + 3, i + 4, i + 5, i + 6, i + 7, i + 8, i + 9, i + 11, i + 12 };
+    const int out = i + 12;
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idxs, 11, ops, &out, 1)) {
+        return false;
+    }
+    ggml_tensor * const * n = cgraph->nodes + i;
+    const ggml_tensor * rel_bias = n[0]->src[0];
+    const ggml_tensor * Rcur     = n[1]->src[1];
+    const ggml_tensor * sinks    = n[2]->src[0];
+    const ggml_tensor * rel_pos  = n[6]->src[1];
+    const ggml_tensor * mask_f16 = n[10]->src[0];
+    const ggml_tensor * dst      = n[12];
+
+    const int32_t * pp = (const int32_t *) n[0]->op_params;
+    if (pp[0] != 0 || pp[1] != 0 || pp[2] != 0 || pp[3] != 1 || pp[4] != 0 || pp[5] != 0 || pp[6] != 0 || pp[7] != 0 || pp[8] != 0) {
+        return false;
+    }
+    if (n[1]->src[0] != n[0] || n[3]->src[0] != n[1] || n[3]->src[1] != n[2] || n[4]->src[0] != n[3] ||
+        n[5]->src[0] != n[4] || n[6]->src[0] != n[5] || n[7]->src[0] != n[6] || n[8]->src[0] != n[7] ||
+        n[9]->src[0] != n[8] || n[11]->src[0] != n[9] || n[11]->src[1] != n[10] || n[12]->src[0] != n[11]) {
+        return false;
+    }
+    const int n_rel  = (int) rel_bias->ne[0];
+    const int n_ext  = (int) rel_bias->ne[1];
+    const int n_head = (int) Rcur->ne[1];
+    const int T      = (int) Rcur->ne[2];
+    const int n_kv   = (int) rel_pos->ne[0];
+    const int TS     = (int) dst->ne[1];
+    const int S      = (int) dst->ne[3];
+    if (n_rel != 16 || n_head < 1 || n_head > 64 || T < 1 || T > 65535 || TS < 1 || TS * S != T || n_kv < 1 ||
+        rel_bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(rel_bias) || rel_bias->ne[2] != 1 || rel_bias->ne[3] != 1 ||
+        Rcur->type != GGML_TYPE_F32 || !ggml_is_contiguous(Rcur) || Rcur->ne[0] != n_rel || Rcur->ne[3] != 1 ||
+        sinks->type != GGML_TYPE_F32 || !ggml_is_contiguous(sinks) || sinks->ne[0] != n_head || sinks->ne[1] != T || sinks->ne[2] != 1 || sinks->ne[3] != 1 ||
+        rel_pos->type != GGML_TYPE_I32 || !ggml_is_contiguous(rel_pos) || rel_pos->ne[1] != T || rel_pos->ne[2] != 1 || rel_pos->ne[3] != 1 ||
+        mask_f16->type != GGML_TYPE_F16 || !ggml_is_contiguous(mask_f16) || mask_f16->ne[0] != n_kv || mask_f16->ne[1] != TS || mask_f16->ne[2] != 1 || mask_f16->ne[3] != S ||
+        dst->type != GGML_TYPE_F16 || !ggml_is_contiguous(dst) || dst->ne[0] != n_kv || dst->ne[2] != n_head ||
+        !ggml_inkling_disjoint(dst, rel_bias) || !ggml_inkling_disjoint(dst, Rcur) || !ggml_inkling_disjoint(dst, sinks) ||
+        !ggml_inkling_disjoint(dst, rel_pos) || !ggml_inkling_disjoint(dst, mask_f16)) {
+        return false;
+    }
+    k_inkling_rel_bias_mask<16><<<dim3((n_kv + 31)/32, T, 1), dim3(32, 8, 1), 0, cuda_ctx->stream()>>>(
+        (const float *) rel_bias->data, (const float *) Rcur->data, (const float *) sinks->data,
+        (const int32_t *) rel_pos->data, (const half *) mask_f16->data, (half *) dst->data,
+        n_ext, n_head, n_kv, TS);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
