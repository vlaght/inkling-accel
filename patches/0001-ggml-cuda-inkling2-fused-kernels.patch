+// local fusion #17 for Inkling 2 (bit 2097152, shared with situ_q8_1): single-row SIGMOID(x) * g with
+// fused Q8_1 pre-quantization into g_q8_1_cache, eliminating 48 quantize_q8_1 launches/tok before wo.
+static __global__ void k_inkling_sigmoid_mul_q8_1(
+        const float * __restrict__ x, const float * __restrict__ g,
+        float * __restrict__ dst, block_q8_1 * __restrict__ y_q8,
+        const int64_t ne0, const int64_t ne0_padded) {
+    const int64_t c = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= ne0_padded) {
+        return;
+    }
+    float xi = 0.0f;
+    if (c < ne0) {
+        xi = (1.0f / (1.0f + expf(-x[c]))) * g[c];
+        dst[c] = xi;
+    }
+    float amax = warp_reduce_max<QK8_1>(fabsf(xi));
+    const float d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : (int8_t) roundf(xi / d);
+    const int sum = warp_reduce_sum<QK8_1>((int) q);
+    const int64_t ib  = c / QK8_1;
+    const int64_t iqs = c % QK8_1;
+    y_q8[ib].qs[iqs] = q;
+    if (iqs == 0) {
+        y_q8[ib].ds = make_half2(d, d * sum);
+    }
+}
