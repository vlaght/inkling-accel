+// local fusion #11 for Inkling 2: the tail of control(): out = cur - tanh(Wf.g)*cur + tanh(Wg.g)*msg, i.e. MUL_MAT, TANH, MUL, SUB, MUL_MAT, TANH, MUL, ADD
+// (eight kernels) in one: a warp per output element takes both rank-R dot products (R is 64) and applies them. The dots are summed in another order than the
+// stock mat-vec (float rounding only). Only for a few tokens (decode, draft verification): a prompt batch is faster on the stock GEMM.
+static __global__ void k_inkling_control_tail(const float * Wf, const float * Wg, const float * g, const float * cur, const float * msg, float * dst,
+        const int n_embd, const int R, const int T) {
+    const int e = blockIdx.x*(blockDim.x/32) + threadIdx.x/32, lane = threadIdx.x % 32;
+    if (e >= n_embd) {
+        return;
+    }
+    const float * wf = Wf + (int64_t) e*R, * wg = Wg + (int64_t) e*R;
+    for (int t = 0; t < T; ++t) {   // the matrices are read from memory for the first token and from the cache after
+        const float * gt = g + (int64_t) t*R;
+        float sf = 0.0f, sg = 0.0f;
+        for (int k = lane; k < R; k += 32) {
+            const float gv = gt[k];
+            sf += wf[k]*gv;
+            sg += wg[k]*gv;
+        }
+        sf = warp_reduce_sum(sf);
+        sg = warp_reduce_sum(sg);
+        if (lane == 0) {
+            const int64_t i = (int64_t) t*n_embd + e;
+            const float c = cur[i];
+            const float out1 = __fsub_rn(c, __fmul_rn(tanhf(sf), c));
+            dst[i] = __fadd_rn(out1, __fmul_rn(tanhf(sg), msg[i]));
+        }
+    }
+}
